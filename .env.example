# Token bot dari Discord Developer Portal → Bot → Reset Token (wajib).
DISCORD_TOKEN=

# Public Key dari Discord Developer Portal → General Information (wajib di Vercel).
DISCORD_PUBLIC_KEY=

# Opsional (hanya untuk `npm run register`): ID server agar slash command langsung muncul saat pengujian.
DISCORD_GUILD_ID=

# Upstash Redis. Bila Redis ditambahkan lewat tab Storage di Vercel, variabel KV_REST_API_URL dan
# KV_REST_API_TOKEN dibuat otomatis — tidak perlu diisi manual.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional: URL publik bot bila tidak memakai domain bawaan <project>.vercel.app.
APP_URL=
