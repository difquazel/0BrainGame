{
  "name": "discord-text-games-bot",
  "version": "3.0.0",
  "private": true,
  "description": "Bot Discord interaktif untuk Werewolf dan game text-based (berjalan di Vercel).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "register": "tsx --env-file-if-exists=.env scripts/register-commands.ts",
    "identify-once": "tsx --env-file-if-exists=.env scripts/identify-once.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.11.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
